{
  "multipart": [
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_bottom"
      }
    },
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_east"
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "dcs_climate:block/build/ditch_top"
      },
      "when": {
        "flag": "true"
      }
    }
  ]
}